#!/bin/sh
# Trava do computador (hook), antes de salvar etapa (commit):
# 1. nada de salvar etapa direto na versão aprovada (main) nem na versão em uso (prod):
#    tudo passa por linha de trabalho e pedido de revisão;
# 2. segredos e arquivos proibidos são barrados no seu computador, antes de irem para o GitHub.
# Ligada uma vez por repositório com: git config core.hooksPath .githooks
# Não pule esta barreira (git commit --no-verify).

RAMO=$(git symbolic-ref --short HEAD 2> /dev/null)
if [ "$RAMO" = "main" ] || [ "$RAMO" = "prod" ]; then
  echo "Salvar etapa (commit) direto na versão aprovada (main) ou na versão em uso (prod) barrado."
  echo "O que fazer: crie uma linha de trabalho (branch) para o chamado (ex.: git switch -c issue-12-nome-curto) e salve a etapa lá."
  exit 1
fi

# Python da .venv, se existir; senão, o do computador.
if [ -x .venv/Scripts/python ]; then PY=.venv/Scripts/python
elif [ -x .venv/bin/python ]; then PY=.venv/bin/python
elif command -v python > /dev/null 2>&1; then PY=python
else PY=python3
fi

if ! "$PY" verificacoes/segredos.py; then
  echo
  echo "Salvar etapa (commit) barrado pela trava do computador. Corrija o que está acima e salve de novo."
  exit 1
fi
